# Copy this file to .env ONLY when you want PostgreSQL locally.
# With no .env file at all, the app uses SQLite and needs zero setup.
DJANGO_SECRET_KEY=replace-with-a-long-random-string-at-least-50-characters
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,web

# Local PostgreSQL from `docker compose up -d db`
POSTGRES_DB=wallet
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Hosts like Render set DATABASE_URL instead, which takes priority:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:8080
TRANSFER_RATE_LIMIT=10/min
REQUEST_RATE_LIMIT=20/min
CHECKOUT_RATE_LIMIT=30/min

# Risk rules (payments that match are held for review in /admin)
RISK_ENABLED=True
